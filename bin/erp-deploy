#!/usr/bin/env bash
set -Eeuo pipefail

# Guarded ERP deployment runner. It never migrates a local database by accident.
ROOT_DIR=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT_DIR"

if [[ ! -f artisan ]]; then
  echo "ERROR: run this from an ERP release containing artisan." >&2
  exit 1
fi

app_env=$(grep -E "^APP_ENV=" .env 2>/dev/null | tail -1 | cut -d= -f2- | tr -d "\"" || true)
if [[ "$app_env" != "production" && "$app_env" != "staging" ]]; then
  echo "ERROR: APP_ENV must be production or staging; detected $app_env." >&2
  exit 1
fi

if [[ "${ERP_DEPLOY_CONFIRM:-}" != "I_HAVE_A_BACKUP" ]]; then
  echo "ERROR: set ERP_DEPLOY_CONFIRM=I_HAVE_A_BACKUP after verifying a recoverable database and private-storage backup." >&2
  exit 1
fi

if [[ "${ERP_DEPLOY_MIGRATE:-1}" == "1" ]]; then
  php artisan migrate --force
fi

php artisan erp:system:health --strict --json
php artisan optimize:clear
php artisan config:cache
php artisan queue:restart

echo "ERP deployment completed: migrations, strict health gate, caches, and queue restart succeeded."
